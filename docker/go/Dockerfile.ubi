# syntax = docker/dockerfile:experimental@sha256:600e5c62eedff338b3f7a0850beb7c05866e0ef27b2d2e8c02aa468e78496ff5
# Interim container so we can copy pulumi binaries
FROM redhat/ubi9-minimal:latest@sha256:6fc28bcb6776e387d7a35a2056d9d2b985dc4e26031e98a2bd35a7137cd6fd71 as builder
ARG PULUMI_VERSION
RUN microdnf upgrade -y && microdnf install -y \
    ca-certificates \
    gzip \
    tar

# Install the Pulumi SDK, including the CLI and language runtimes.
RUN curl -fsSL https://get.pulumi.com/ | bash -s -- --version $PULUMI_VERSION

# Set from .github/scripts/matrix/versions.py by the build workflows. UBI images are only built for amd64.
ARG LANGUAGE_VERSION
ARG GO_AMD64_SHA256

WORKDIR /golang
RUN curl -fsSLo /tmp/go.tgz https://golang.org/dl/go${LANGUAGE_VERSION:?}.linux-amd64.tar.gz && \
    echo "${GO_AMD64_SHA256:?} /tmp/go.tgz" | sha256sum -c - && \
    mkdir -p bin && \
    tar -C /golang -xzf /tmp/go.tgz && \
    rm /tmp/go.tgz && \
    export PATH="/golang/go/bin:${PATH}" && \
    go version

# The runtime container
FROM redhat/ubi9-minimal:latest@sha256:6fc28bcb6776e387d7a35a2056d9d2b985dc4e26031e98a2bd35a7137cd6fd71
LABEL org.opencontainers.image.description="Pulumi CLI container for go"
WORKDIR /pulumi/projects

# Install needed tools, like git
RUN microdnf upgrade -y && microdnf install -y \
    git \
    tar \
    ca-certificates; \
    mkdir -p /go

# Uses the workdir
COPY --from=builder /golang/go /usr/local
# Uses the workdir, copies from pulumi interim container
COPY --from=builder /root/.pulumi/bin/pulumi /pulumi/bin/pulumi
COPY --from=builder /root/.pulumi/bin/pulumi-language-go /pulumi/bin/pulumi-language-go
ENV GOPATH=/go
ENV CGO_ENABLED=0
ENV PATH "/pulumi/bin:${GOPATH}/bin:${PATH}"

CMD ["pulumi"]
