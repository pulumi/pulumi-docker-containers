# syntax = docker/dockerfile:experimental@sha256:600e5c62eedff338b3f7a0850beb7c05866e0ef27b2d2e8c02aa468e78496ff5
# Interim container so we can copy pulumi binaries
FROM redhat/ubi9-minimal:latest@sha256:6fc28bcb6776e387d7a35a2056d9d2b985dc4e26031e98a2bd35a7137cd6fd71 as builder
ARG PULUMI_VERSION
RUN microdnf upgrade -y && microdnf install -y \
    p11-kit \
    ca-certificates \
    gzip \
    tar

# eMudhra incident: block both trust paths until UBI ships updated roots.
# https://bugzilla.redhat.com/show_bug.cgi?id=2556376
# Check upstream without this workaround; both probes must exit 60 (certificate rejection).
# A connection/DNS error does not confirm the fix. Remove the workaround once
# upstream rejects both affected trust paths.
# docker run --rm redhat/ubi9-minimal:latest sh -c '
#   microdnf upgrade -y || exit 1
#   for host in dv-g3b-emudhra dv-g3b-aaa-emudhra; do
#     curl --connect-timeout 10 --max-time 30 "https://${host}.we-have-a-problem.com/"
#     [ "$?" -eq 60 ] || exit 1
#   done'
RUN set -eu; \
    blocklist=/etc/pki/ca-trust/source/blocklist; \
    if [ ! -d "$blocklist" ]; then blocklist=/etc/pki/ca-trust/source/blacklist; fi; \
    trust extract --overwrite --format=pem-bundle \
      --filter='pkcs11:object=Comodo%20AAA%20Services%20root;type=cert' \
      "$blocklist/Comodo_AAA_Services_root.pem"; \
    [ -s "$blocklist/Comodo_AAA_Services_root.pem" ]; \
    trust extract --overwrite --format=pem-bundle \
      --filter='pkcs11:object=emSign%20ECC%20Root%20CA%20-%20G3;type=cert' \
      "$blocklist/emSign_ECC_Root_CA_-_G3.pem"; \
    [ -s "$blocklist/emSign_ECC_Root_CA_-_G3.pem" ]; \
    update-ca-trust

# Install the Pulumi SDK, including the CLI and language runtimes.
RUN curl -fsSL https://get.pulumi.com/ | bash -s -- --version $PULUMI_VERSION

# The runtime container
FROM redhat/ubi9-minimal:latest@sha256:6fc28bcb6776e387d7a35a2056d9d2b985dc4e26031e98a2bd35a7137cd6fd71
ARG LANGUAGE_VERSION
LABEL org.opencontainers.image.description="Pulumi CLI container for python"
WORKDIR /pulumi/projects

# Install needed tools, like git, and build dependencies
RUN microdnf upgrade -y && microdnf install -y \
    p11-kit \
    bzip2 \
    bzip2-devel \
    ca-certificates \
    findutils \
    gcc \
    gdbm-libs \
    git \
    libffi-devel \
    libnsl2 \
    libuuid-devel \
    make \
    ncurses \
    ncurses-devel \
    openssl-devel \
    patch \
    readline \
    sqlite \
    sqlite-devel \
    tar \
    xz-devel \
    zlib-devel

# eMudhra incident: block both trust paths until UBI ships updated roots.
# https://bugzilla.redhat.com/show_bug.cgi?id=2556376
# Check upstream without this workaround; both probes must exit 60 (certificate rejection).
# A connection/DNS error does not confirm the fix. Remove the workaround once
# upstream rejects both affected trust paths.
# docker run --rm redhat/ubi9-minimal:latest sh -c '
#   microdnf upgrade -y || exit 1
#   for host in dv-g3b-emudhra dv-g3b-aaa-emudhra; do
#     curl --connect-timeout 10 --max-time 30 "https://${host}.we-have-a-problem.com/"
#     [ "$?" -eq 60 ] || exit 1
#   done'
RUN set -eu; \
    blocklist=/etc/pki/ca-trust/source/blocklist; \
    if [ ! -d "$blocklist" ]; then blocklist=/etc/pki/ca-trust/source/blacklist; fi; \
    trust extract --overwrite --format=pem-bundle \
      --filter='pkcs11:object=Comodo%20AAA%20Services%20root;type=cert' \
      "$blocklist/Comodo_AAA_Services_root.pem"; \
    [ -s "$blocklist/Comodo_AAA_Services_root.pem" ]; \
    trust extract --overwrite --format=pem-bundle \
      --filter='pkcs11:object=emSign%20ECC%20Root%20CA%20-%20G3;type=cert' \
      "$blocklist/emSign_ECC_Root_CA_-_G3.pem"; \
    [ -s "$blocklist/emSign_ECC_Root_CA_-_G3.pem" ]; \
    update-ca-trust

# Install python using pyenv
RUN git clone --depth=1 https://github.com/pyenv/pyenv.git /usr/local/share/pyenv
ENV PYENV_ROOT=/usr/local/share/pyenv
ENV PATH="${PYENV_ROOT}/shims:${PYENV_ROOT}/bin:${PATH}"
RUN pyenv install ${LANGUAGE_VERSION}
RUN pyenv global ${LANGUAGE_VERSION}

# Update pip's vendored CA bundle before installing Python tools.
RUN python3 -m pip install --no-cache-dir --upgrade "pip>=26.2.2"

# Install poetry
RUN curl -sSL https://install.python-poetry.org | POETRY_HOME=/usr/local/share/pypoetry python3 -
RUN /usr/local/share/pypoetry/venv/bin/python -m pip install --no-cache-dir --upgrade "pip>=26.2.2" "certifi>=2026.10.19"
RUN ln -s /usr/local/share/pypoetry/bin/poetry /usr/local/bin/

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | XDG_BIN_HOME=/usr/local/share/uv bash -s -- --no-modify-path
RUN ln -s /usr/local/share/uv/uv /usr/local/bin/
RUN ln -s /usr/local/share/uv/uvx /usr/local/bin/

# Uses the workdir, copies from pulumi interim container
COPY --from=builder /root/.pulumi/bin/pulumi /pulumi/bin/pulumi
COPY --from=builder /root/.pulumi/bin/*-python* /pulumi/bin/
ENV PATH "/pulumi/bin:${PATH}"

CMD ["pulumi"]
